# --- GitHub App (from https://github.com/settings/apps/<your-app>) ---
APP_ID=
# Path to the private key .pem you downloaded, or paste the key into PRIVATE_KEY instead.
PRIVATE_KEY_PATH=./private-key.pem
WEBHOOK_SECRET=
# For local development: create a channel at https://smee.io and paste the URL here.
WEBHOOK_PROXY_URL=
PORT=3000
LOG_LEVEL=info

# --- LLM (bring your own key) ---
# Which AI service writes the summaries. Supported: anthropic
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Cheapest Claude model. For better summaries try claude-sonnet-5-5 or claude-opus-5-5.
LLM_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max
LLM_EFFORT=medium
# How many chunk summaries run at once.
LLM_CONCURRENCY=4

# --- Queue ---
# Leave empty to use the in-process queue (fine for local development and a single instance).
# Set it to use Redis + BullMQ, e.g. redis://localhost:6379
REDIS_URL=
